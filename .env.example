# ─────────────────────────────────────────────────────────────────────────────
# Pro2Link Admin — variables d'environnement (préfixe VITE_ : PUBLIQUES, incluses
# dans le bundle livré au navigateur). N'y mettez JAMAIS de secret.
# Copier en .env.development.local (dev) ou .env.production.local (build).
# ─────────────────────────────────────────────────────────────────────────────

# URL de base de l'API (préfixe réel du backend : /api/v1).
# - Développement : laisser /api/v1, le proxy Vite redirige vers le backend.
# - Production : même domaine derrière un reverse proxy (/api/v1) ou URL complète,
#   ex. https://api.pro2link.sn/api/v1 (le back-office doit alors figurer dans
#   CORS_ORIGIN du backend et partager le même domaine principal : cookie SameSite=Strict).
VITE_API_BASE_URL=/api/v1

# Développement uniquement : backend vers lequel le proxy Vite redirige /api et /health.
VITE_API_PROXY_TARGET=http://localhost:3000

# Chemin de publication du back-office : « / » à la racine d'un sous-domaine
# (admin.pro2link.sn), ou par ex. « /admin/ » sous le domaine du site.
VITE_BASE_PATH=/

# URL du site vitrine (lien « Retour au site », renvoi des comptes entreprise). Vide : masqué.
VITE_SITE_URL=
